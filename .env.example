# Supabase (Prosjekt i regionen eu-north-1 / Stockholm)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Kun på serveren. Brukes av bakgrunnsjobbene (fase 2).
SUPABASE_SECRET_KEY=sb_secret_...

# Kommaseparert liste over e-postadresser som får logge inn
ALLOWED_EMAILS=deg@example.com,far@example.com

# Offentlig adresse til appen (brukes i magisk lenke)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fase 2: researchagenten
ANTHROPIC_API_KEY=sk-ant-...
# Delt hemmelighet mellom Supabase pg_cron og /api/jobs/run-step
JOB_SECRET=lang-tilfeldig-streng
